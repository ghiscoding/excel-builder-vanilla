{
  "name": "excel-builder-vanilla-root",
  "description": "An easy way of building Excel files with javascript",
  "private": true,
  "keywords": [
    "excel",
    "javascript",
    "xlsx",
    "spreadsheet"
  ],
  "author": "Stephen Liberty",
  "contributors": [
    {
      "name": "Ghislain B."
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/ghiscoding/excel-builder-vanilla",
  "bugs": {
    "url": "https://github.com/ghiscoding/excel-builder-vanilla/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghiscoding/excel-builder-vanilla.git"
  },
  "funding": {
    "type": "ko_fi",
    "url": "https://ko-fi.com/ghiscoding"
  },
  "scripts": {
    "clean": "remove --glob **/dist --glob **/tsconfig.tsbuildinfo --stat",
    "build": "pnpm clean && pnpm biome:lint:write && pnpm biome:format:write && pnpm -r --stream build",
    "build:demo": "pnpm -r --stream --filter \"./packages/demo/**\" build",
    "build:lib": "pnpm -r --stream --filter \"./packages/excel-builder-vanilla/**\" build",
    "dev": "pnpm -r dev:init && pnpm -r --parallel dev",
    "biome:lint:check": "biome lint ./packages",
    "biome:lint:write": "biome lint --write ./packages",
    "biome:format:check": "biome format ./packages",
    "biome:format:write": "biome format --write ./packages",
    "preview:version": "lerna version --dry-run",
    "preview:publish": "lerna publish from-package --dry-run",
    "new-version": "lerna version",
    "new-publish": "lerna publish from-package",
    "roll-new-release": "pnpm build && pnpm new-version && pnpm new-publish",
    "serve:demo": "pnpm -r --stream --filter \"./packages/demo/**\" dev",
    "playwright:install": "pnpm exec playwright install --with-deps chromium",
    "test": "vitest --coverage --config ./vitest/vitest.config.mts",
    "test:browser": "vitest --config ./vitest/vitest.browser.config.mts",
    "test:browser:ui": "vitest --config ./vitest/vitest.browser.config.mts --ui",
    "test:browser:watch": "vitest --watch --config ./vitest/vitest.browser.config.mts",
    "test:watch": "vitest --watch --config ./vitest/vitest.config.mts",
    "demo:node:streaming": "node ./packages/demo/node-examples/node-streaming-demo.mjs",
    "demo:node:non-streaming": "node ./packages/demo/node-examples/node-non-streaming-demo.mjs"
  },
  "engines": {
    "node": "^22.17.0 || >=24.0.0",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@lerna-lite/cli": "^5.6.1",
    "@lerna-lite/publish": "^5.6.1",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "4.1.11",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "remove-glob": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
